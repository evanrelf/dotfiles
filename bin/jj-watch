#!/usr/bin/env bash

# https://docs.jj-vcs.dev/latest/FAQ/#can-i-monitor-how-jj-log-evolves

set -Eeuo pipefail
IFS=$'\n\t'

root=$(jj root)

watchexec \
  --quiet \
  --clear \
  --restart \
  --project-origin "$root" \
  --shell none \
  --wrap-process none \
  -- \
  watchexec \
    --quiet \
    --clear \
    --restart \
    --project-origin "$root" \
    --watch /.jj/repo/op_heads/heads \
    --ignore-nothing \
    --shell none \
    --wrap-process none \
    -- jj "$@"
